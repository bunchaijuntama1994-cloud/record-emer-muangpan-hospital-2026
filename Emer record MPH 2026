        // ================= ปุ่มคัดลอกข้อความไป Microsoft Word =================
        function copyToClipboard() {
            if (timelineEvents.length === 0) {
                alert("ไม่มีข้อมูลใน Summary Record ให้คัดลอก");
                return;
            }

            // จัดเรียงลำดับเวลาก่อนแปลงเป็นข้อความดิบ
            const sortedEvents = [...timelineEvents].sort((a, b) => a.time.localeCompare(b.time));
            
            // ดึงค่าหัวข้อผู้ป่วย (ถ้ากรอกไว้) ไปแสดงด้านบน
            let textOutput = "=========================================\n";
            textOutput += "     NURSE NOTE SUMMARY RECORD (ER MPH)  \n";
            textOutput += "        โรงพยาบาลเมืองปาน จังหวัดลำปาง       \n";
            textOutput += "=========================================\n\n";

            sortedEvents.forEach((ev, index) => {
                textOutput += `[${ev.time} น.] - ${ev.title}\n`;
                // แยกข้อความกรณีมีแท็ก <br> หรือ <b> ในสไตล์ HTML ออกเป็นข้อความดิบ
                let cleanDesc = ev.description.replace(/<br>/gi, '\n      ').replace(/<\/?[^>]+(>|$)/g, "");
                textOutput += `รายละเอียด: ${cleanDesc}\n`;
                textOutput += `-----------------------------------------\n`;
            });

            // ใช้ Clipboard API เพื่อจำค่าเข้าสู่ระบบ Clipboard ของอุปกรณ์
            navigator.clipboard.writeText(textOutput).then(() => {
                alert("📋 คัดลอกข้อความใน Summary Record เรียงตามเวลาสำเร็จแล้ว! คุณสามารถเปิด Microsoft Word และกด Ctrl+V (หรือปุ่มวาง) ได้ทันที");
            }).catch(err => {
                console.error('ไม่สามารถคัดลอกได้: ', err);
                alert("ไม่สามารถคัดลอกข้อความอัตโนมัติได้ กรุณาลองใหม่อีกครั้ง");
            });
        }
