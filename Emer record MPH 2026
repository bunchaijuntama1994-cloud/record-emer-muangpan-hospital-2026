    <!-- JAVASCRIPT LOGIC -->
    <script>
        let timelineEvents = [];

        function setToday(id) {
            document.getElementById(id).value = new Date().toISOString().split('T')[0];
        }

        function setNow(id) {
            document.getElementById(id).value = new Date().toTimeString().split(' ')[0].substring(0, 5);
        }

        function getSystemTime() {
            return new Date().toTimeString().split(' ')[0].substring(0, 5);
        }

        // เพิ่มเหตุการณ์เข้าฐานข้อมูลเวิร์กสเปซและอัปเดตวิว
        function addEvent(time, title, description, category = 'info') {
            const t = time ? time : getSystemTime();
            const id = Date.now() + Math.random().toString(36).substr(2, 4);
            timelineEvents.push({ id, time: t, title, description, category });
            renderTimeline();
        }

        // เรียงลำดับประวัติและสร้าง UI ตามไทม์ไลน์จริงก่อนและหลัง
        function renderTimeline() {
            const container = document.getElementById('timeline_container');
            if (timelineEvents.length === 0) {
                container.innerHTML = `<p class="text-gray-400 text-center py-12 italic">ยังไม่มีข้อมูลบันทึกตามเวลา</p>`;
                return;
            }

            // คีย์เวิร์ดการคัดแยกเรียงลำดับเวลา (Time Sorting Lexicographically)
            timelineEvents.sort((a, b) => a.time.localeCompare(b.time));
            container.innerHTML = '';

            timelineEvents.forEach(ev => {
                let borderTheme = 'border-sky-500 bg-slate-800';
                if (ev.category === 'critical') borderTheme = 'border-red-500 bg-red-950/30 text-red-200';
                if (ev.category === 'triage') borderTheme = 'border-emerald-500 bg-emerald-950/20';
                if (ev.category === 'med') borderTheme = 'border-pink-500 bg-pink-950/20';

                const div = document.createElement('div');
                div.className = `p-2 rounded border-l-4 ${borderTheme} relative group shadow-sm`;
                div.innerHTML = `
                    <button onclick="deleteEvent('${ev.id}')" class="absolute top-1 right-1 text-gray-500 hover:text-red-400 opacity-0 group-hover:opacity-100 transition text-[11px]">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    <div class="flex justify-between items-center mb-0.5">
                        <span class="text-[11px] font-mono font-bold text-yellow-300 bg-black/40 px-1.5 py-0.2 rounded">${ev.time} น.</span>
                        <span class="text-[10px] font-semibold text-gray-400">${ev.title}</span>
                    </div>
                    <div class="text-[11px] leading-relaxed text-gray-200">${ev.description}</div>
                `;
                container.appendChild(div);
            });
        }

        function deleteEvent(id) {
            timelineEvents = timelineEvents.filter(ev => ev.id !== id);
            renderTimeline();
        }

        function clearAllTimeline() {
            if(confirm("ต้องการล้างรายการข้อความบันทึกทั้งหมดใช่หรือไม่?")) {
                timelineEvents = [];
                renderTimeline();
            }
        }

        function clearSingleField(id) {
            document.getElementById(id).value = '';
        }

        function clearPrimaryFields(selId, noteId, timeId) {
            document.getElementById(selId).value = 'Pass';
            document.getElementById(noteId).value = '';
            document.getElementById(timeId).value = '';
        }

        // คำนวณคะแนนตามสเกล SIRS & NEWS2
        function calculateScores() {
            let sirs = 0; let news2 = 0;
            const bt = parseFloat(document.getElementById('vs_bt').value);
            const rr = parseInt(document.getElementById('vs_rr').value);
            const hr = parseInt(document.getElementById('vs_hr').value);
            const spo2 = parseInt(document.getElementById('vs_spo2').value);
            const o2 = document.getElementById('vs_o2_req').value;
            const avpu = document.getElementById('vs_avpu').value;
            const wbc = parseInt(document.getElementById('vs_wbc').value);

            if (bt > 38 || bt < 36) sirs++;
            if (hr > 90) sirs++;
            if (rr > 20) sirs++;
            if (wbc > 12000 || wbc < 4000) sirs++;
            document.getElementById('sirs_score').innerText = isNaN(sirs) ? 0 : sirs;

            if (rr >= 25) news2 += 3; else if (rr >= 21) news2 += 2; else if (rr >= 12) news2 += 0; else if (rr >= 9) news2 += 1; else if (rr <= 8 && rr > 0) news2 += 3;
            if (spo2 <= 91) news2 += 3; else if (spo2 <= 93) news2 += 2; else if (spo2 <= 95) news2 += 1;
            if (o2 === 'ใช้') news2 += 2;
            if (bt >= 39.1) news2 += 3; else if (bt >= 38.1) news2 += 1; else if (bt >= 36.1) news2 += 0; else if (bt >= 35.1) news2 += 1; else if (bt <= 35.0) news2 += 3;
            if (hr >= 131) news2 += 3; else if (hr >= 111) news2 += 2; else if (hr >= 91) news2 += 1; else if (hr >= 51) news2 += 0; else if (hr >= 41) news2 += 1; else if (hr <= 40 && hr > 0) news2 += 3;
            if (avpu !== 'A') news2 += 3;

            document.getElementById('news2_score').innerText = isNaN(news2) ? 0 : news2;
        }

        function clearForm(type) {
            if(type === 'vital-signs') {
                document.getElementById('vs_bt').value = ''; document.getElementById('vs_rr').value = '';
                document.getElementById('vs_hr').value = ''; document.getElementById('vs_bp').value = '';
